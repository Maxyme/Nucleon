+/* Private compatibility ABI used by the pinned MacRunner DXMT companion.
+ * Its older Wine layout has two view slots. Do not expose our internal layout:
+ * retain the window lock while returning a per-thread snapshot of those slots.
+ */
+struct dxmt_window_data
+{
+    HWND hwnd;
+    macdrv_window cocoa_window;
+    macdrv_view cocoa_view;
+    macdrv_view client_cocoa_view;
+};
+
+static _Thread_local struct dxmt_window_data dxmt_data;
+static _Thread_local struct macdrv_win_data *dxmt_locked_data;
+
+static struct dxmt_window_data *dxmt_get_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data = get_win_data(hwnd);
+    if (!data) return NULL;
+    dxmt_locked_data = data;
+    dxmt_data.hwnd = data->hwnd;
+    dxmt_data.cocoa_window = data->cocoa_window;
+    dxmt_data.cocoa_view = data->client_view;
+    if (!dxmt_data.cocoa_view && data->cocoa_window)
+        dxmt_data.cocoa_view = macdrv_window_get_content_view(data->cocoa_window);
+    dxmt_data.client_cocoa_view = dxmt_data.cocoa_view;
+    return &dxmt_data;
+}
+
+static void dxmt_release_win_data(struct dxmt_window_data *data)
+{
+    if (!data) return;
+    release_win_data(dxmt_locked_data);
+    dxmt_locked_data = NULL;
+}
+
+/* Preserve the reference's ten-slot table; only its window/Metal entries are
+ * consumed by winemetal. The unused display/main-thread slots stay NULL.
+ */
+DECLSPEC_EXPORT const struct
+{
+    void (*init_display_devices)(BOOL);
+    struct dxmt_window_data *(*get_win_data)(HWND);
+    void (*release_win_data)(struct dxmt_window_data *);
+    macdrv_window (*get_cocoa_window)(HWND, BOOL);
+    macdrv_metal_device (*create_metal_device)(void);
+    void (*release_metal_device)(macdrv_metal_device);
+    macdrv_metal_view (*create_metal_view)(macdrv_view, macdrv_metal_device);
+    macdrv_metal_layer (*get_metal_layer)(macdrv_metal_view);
+    void (*release_metal_view)(macdrv_metal_view);
+    void (*on_main_thread)(void *);
+} macdrv_functions =
+{
+    NULL, dxmt_get_win_data, dxmt_release_win_data, macdrv_get_cocoa_window,
+    macdrv_create_metal_device, macdrv_release_metal_device,
+    macdrv_view_create_metal_view, macdrv_view_get_metal_layer,
+    macdrv_view_release_metal_view, NULL
+};
