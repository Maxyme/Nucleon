+
+static BOOL switchyard_wstr_equals_ascii( const WCHAR *value, ULONG len, const char *ascii )
+{
+    ULONG i;
+
+    for (i = 0; i < len && ascii[i]; ++i)
+    {
+        WCHAR ch = value[i];
+        char expected = ascii[i];
+
+        if (ch >= 'A' && ch <= 'Z') ch += 'a' - 'A';
+        if (ch != expected) return FALSE;
+    }
+    return i == len && !ascii[i];
+}
+
+static BOOL switchyard_parse_gfxt_deferred_vtable_index( const WCHAR **cursor,
+                                                         const WCHAR *end, unsigned int *value )
+{
+    const WCHAR *p = *cursor;
+    unsigned int ret = 0;
+
+    if (p >= end || *p < '0' || *p > '9') return FALSE;
+    while (p < end && *p >= '0' && *p <= '9')
+    {
+        ret = ret * 10 + *p - '0';
+        if (ret > 1000) return FALSE;
+        ++p;
+    }
+
+    *cursor = p;
+    *value = ret;
+    return TRUE;
+}
+
+static BOOL switchyard_gfxt_deferred_vtable_entry_enabled( unsigned int index )
+{
+    static const WCHAR separators[] = { ',', ';', ' ', '\t' };
+    UNICODE_STRING name = RTL_CONSTANT_STRING( L"SWITCHYARD_GFXT_DEFERRED_WRAP" );
+    WCHAR buffer[128];
+    UNICODE_STRING value = { 0, sizeof(buffer), buffer };
+    const WCHAR *p, *end;
+    ULONG len;
+
+    if (RtlQueryEnvironmentVariable_U( NULL, &name, &value ))
+        return switchyard_gfxt_deferred_vtable_entry_enabled_by_default( index );
+
+    len = value.Length / sizeof(WCHAR);
+    if (!len) return FALSE;
+    if (switchyard_wstr_equals_ascii( value.Buffer, len, "all" )) return TRUE;
+    if (switchyard_wstr_equals_ascii( value.Buffer, len, "none" )) return FALSE;
+
+    p = value.Buffer;
+    end = value.Buffer + len;
+    while (p < end)
+    {
+        unsigned int first, last, i;
+        BOOL matched_separator;
+
+        do
+        {
+            matched_separator = FALSE;
+            for (i = 0; i < ARRAY_SIZE(separators); ++i)
+            {
+                if (p < end && *p == separators[i])
+                {
+                    ++p;
+                    matched_separator = TRUE;
+                }
+            }
+        } while (matched_separator);
+
+        if (!switchyard_parse_gfxt_deferred_vtable_index( &p, end, &first )) return FALSE;
+        last = first;
+        if (p < end && *p == '-')
+        {
+            ++p;
+            if (!switchyard_parse_gfxt_deferred_vtable_index( &p, end, &last )) return FALSE;
+        }
+        if (first <= index && index <= last) return TRUE;
+
+        if (p < end)
+        {
+            matched_separator = FALSE;
+            for (i = 0; i < ARRAY_SIZE(separators); ++i)
+            {
+                if (*p == separators[i])
+                {
+                    matched_separator = TRUE;
+                    break;
+                }
+            }
+            if (!matched_separator) return FALSE;
+        }
+    }
+
+    return FALSE;
+}
+
+static BOOL switchyard_store_native_callback_thunk( void **slot, void *thunk )
+{
+    void *addr = slot;
+    SIZE_T size = sizeof(*slot);
+    ULONG old_prot;
+    BOOL ret = FALSE;
+
+    if (!NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size,
+                                 PAGE_EXECUTE_READWRITE, &old_prot ))
+    {
+        *slot = thunk;
+        ret = TRUE;
+        NtProtectVirtualMemory( NtCurrentProcess(), &addr, &size, old_prot, &old_prot );
+    }
+    else
+    {
+        /* Native Mach-O __DATA mappings are outside Wine's virtual-memory map,
+         * even when the host mapping itself is writable. */
+        __TRY
+        {
+            *slot = thunk;
+            ret = TRUE;
+        }
+        __EXCEPT_PAGE_FAULT
+        {
+            ret = FALSE;
+        }
+        __ENDTRY
+    }
+
+    return ret;
+}
+
+static BOOL switchyard_wrap_protected_native_callback_entry( void **slot, unsigned int argc,
+                                                              ULONG flags )
+{
+    void *func, *thunk;
+
+    if (!slot || !(func = *slot) || !is_native_callback_target( func )) return FALSE;
+    if (!(thunk = create_native_callback_thunk( func, argc, flags ))) return FALSE;
+    if (!switchyard_store_native_callback_thunk( slot, thunk )) return FALSE;
+
+    TRACE( "bridging protected native callback entry %p target %p argc %u thunk %p\n",
+           slot, func, argc, thunk );
+    return TRUE;
+}
+
+static BOOL switchyard_get_native_callback_jump_table_slot( void *entry, void ***result )
+{
+    static const BYTE jump_entry_prefix[] = { 0xff, 0x25, 0x02, 0x00, 0x00, 0x00, 0x00, 0x00 };
+    static const BYTE nop_jump_entry_prefix[] = { 0x66, 0x90, 0xff, 0x25, 0x00, 0x00, 0x00, 0x00 };
+    static const BYTE adjusted_jump_entry_prefix[] = { 0x48, 0x83, 0xe9, 0x10, 0x48, 0xb8 };
+    static const BYTE adjusted_jump_entry_suffix[] = { 0xff, 0xe0 };
+    void **slot;
+    void *target;
+
+    if (!entry) return FALSE;
+    if (!memcmp( entry, jump_entry_prefix, sizeof(jump_entry_prefix) ) ||
+        !memcmp( entry, nop_jump_entry_prefix, sizeof(nop_jump_entry_prefix) ))
+        slot = (void **)((BYTE *)entry + sizeof(jump_entry_prefix));
+    else if (!memcmp( entry, adjusted_jump_entry_prefix, sizeof(adjusted_jump_entry_prefix) ) &&
+             !memcmp( (BYTE *)entry + 14, adjusted_jump_entry_suffix,
+                      sizeof(adjusted_jump_entry_suffix) ))
+        slot = (void **)((BYTE *)entry + sizeof(adjusted_jump_entry_prefix));
+    else return FALSE;
+
+    target = *slot;
+    if ((ULONG_PTR)target < 0x10000 || target == (void *)(ULONG_PTR)0xbad ||
+        target == __wine_syscall_dispatcher || target == (void *)__wine_unix_call_dispatcher)
+        return FALSE;
+
+    if (result) *result = slot;
+    return TRUE;
+}
+
+static BOOL switchyard_wrap_native_callback_jump_table_entry( void *entry, unsigned int argc,
+                                                               ULONG flags )
+{
+    void **slot;
+
+    if (!switchyard_get_native_callback_jump_table_slot( entry, &slot )) return FALSE;
+
+    return switchyard_wrap_protected_native_callback_entry( slot, argc, flags );
+}
+
+static BOOL switchyard_wrap_native_callback_vtable_slot_locked(
+    void **slot, unsigned int argc, ULONG flags )
+{
+    void *entry, *thunk;
+
+    if (!slot) return FALSE;
+    entry = *slot;
+    if (is_native_callback_thunk( entry ))
+    {
+        unsigned int old_argc;
+        ULONG old_flags;
+        void *target;
+
+        if (!switchyard_get_native_callback_thunk_info(
+                entry, &target, &old_argc, &old_flags )) return FALSE;
+        if ((flags & SWITCHYARD_NATIVE_CALLBACK_OUTPUT_ARG_MASK) &&
+            (old_flags & SWITCHYARD_NATIVE_CALLBACK_OUTPUT_ARG_MASK) &&
+            (flags & SWITCHYARD_NATIVE_CALLBACK_OUTPUT_ARG_MASK) !=
+            (old_flags & SWITCHYARD_NATIVE_CALLBACK_OUTPUT_ARG_MASK)) return FALSE;
+        argc = max( argc, old_argc );
+        flags |= old_flags;
+        if (argc == old_argc && flags == old_flags) return TRUE;
+        if (!(thunk = create_native_callback_thunk( target, argc, flags ))) return FALSE;
+        if (!switchyard_store_native_callback_thunk( slot, thunk )) return FALSE;
+        TRACE( "upgraded COM vtable slot %p argc %u flags %#lx thunk %p\n",
+               slot, argc, flags, thunk );
+        return TRUE;
+    }
+    if (switchyard_get_native_callback_jump_table_slot( entry, NULL ))
+    {
+        if (!(thunk = create_native_callback_thunk( entry, argc, flags ))) return FALSE;
+        if (!switchyard_store_native_callback_thunk( slot, thunk )) return FALSE;
+        TRACE( "bridged COM vtable jump-stub slot %p entry %p argc %u\n", slot, entry, argc );
+        return TRUE;
+    }
+    if (!is_native_callback_target( entry ))
+    {
+        TRACE( "skipping COM vtable slot %p entry %p argc %u: not native target\n",
+               slot, entry, argc );
+        return FALSE;
+    }
+
+    return switchyard_wrap_protected_native_callback_entry( slot, argc, flags );
+}
+
+static BOOL switchyard_wrap_native_callback_vtable_slot(
+    void **slot, unsigned int argc, ULONG flags )
+{
+    BOOL ret;
+
+    RtlEnterCriticalSection( &loader_section );
+    ret = switchyard_wrap_native_callback_vtable_slot_locked( slot, argc, flags );
+    RtlLeaveCriticalSection( &loader_section );
+    return ret;
+}
