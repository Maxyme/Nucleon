+        if (table[41] && table[42] == (void *)0x1000000)
+        {
+            callback_count = SWITCHYARD_GPTK_WIN32_CALLBACK_LEGACY_ENTRIES;
+            entry_count = SWITCHYARD_GPTK_WIN32_DISPATCH_LEGACY_ENTRIES;
+        }
