@@ -2278,6 +2360,15 @@ static NTSTATUS build_module( LPCWSTR load_path, const UNICODE_STRING *nt_name,
 
     update_load_config( *module );
 
+#ifdef __x86_64__
+    if (!is_builtin)
+    {
+        BOOL did_redirect;
+        if ((status = nucleon_redirect_steamclient( wm, load_path, &did_redirect ))) return status;
+        if (did_redirect) flags |= DONT_RESOLVE_DLL_REFERENCES;
+    }
+#endif
+
