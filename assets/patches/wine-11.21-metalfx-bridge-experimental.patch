+    get_increment_func get_increment;
+    ULONG increment = 0;
+
+    if (!(get_increment = switchyard_get_wrapped_com_vtable_entry( device, 15 )))
+        return 0;
+
+    __TRY
+    {
+        increment = get_increment( device, heap_type );
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+    }
+    __ENDTRY
