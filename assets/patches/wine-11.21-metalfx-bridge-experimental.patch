+{
+    void **vtable;
+    void *ret = NULL;
+
+    if (!object) return NULL;
+
+    __TRY
+    {
+        vtable = *(void ***)object;
+        if (!vtable) return NULL;
+        if (is_native_callback_thunk( vtable[index] ))
+            ret = vtable[index];
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+    }
+    __ENDTRY
