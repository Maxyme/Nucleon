+static void CALLBACK switchyard_unlock_d3d_shared_texture( BOOL normal, void *ctx )
+{
+    struct switchyard_d3d_shared_texture *entry = ctx;
+
+    (void)normal;
+    NtReleaseMutant( entry->mutant, NULL );
+}
