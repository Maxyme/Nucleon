+/* DXMT's legacy window bridge also needs the toplevel view before any GL/Vulkan
+ * client surface has been created. The window-data lock protects its lifetime.
+ */
+macdrv_view macdrv_window_get_content_view(macdrv_window w)
+{
+    __block NSView *view;
+    OnMainThread(^{ view = [(NSWindow *)w contentView]; });
+    return (macdrv_view)view;
+}
