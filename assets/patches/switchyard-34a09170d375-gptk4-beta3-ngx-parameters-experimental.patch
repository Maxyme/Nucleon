+/* NGX parameter maps are not IUnknown objects: 8 Set overloads, 8 Get
+ * overloads, then Reset. GPTK beta 3 uses the Microsoft overload order. */
+static void *switchyard_ngx_parameter_output_functions[6];
+
+static void switchyard_wrap_ngx_parameter_output(
+    const struct switchyard_native_callback_params *params, ULONG_PTR ret )
+{
+    unsigned int i;
+    void *object;
+    void **vtable, **wrapped;
+    ULONG_PTR signature;
 
+    if (params->argc != 1 || ret != 1 || !params->args[0]) return;
+    for (i = 0; i < ARRAY_SIZE(switchyard_ngx_parameter_output_functions); ++i)
+        if (params->func == switchyard_ngx_parameter_output_functions[i]) break;
+    if (i == ARRAY_SIZE(switchyard_ngx_parameter_output_functions)) return;
+
+    __TRY
+    {
+        object = *(void **)params->args[0];
+        if (!object || !(vtable = *(void ***)object)) return;
+        signature = switchyard_com_vtable_wrapper_signature_seed( 17, FALSE );
+        for (i = 0; i < 17; ++i)
+        {
+            ULONG flags = SWITCHYARD_NATIVE_CALLBACK_SHARE_THUNK;
+            if (i == 5 || i == 6)
+                flags |= SWITCHYARD_NATIVE_CALLBACK_D3D11_CONTEXT_CLEAR_DEPTH_STENCIL_VIEW |
+                         SWITCHYARD_NATIVE_CALLBACK_OUTPUT_ARG( i == 5 ? 5 : 4 );
+            signature = switchyard_com_vtable_wrapper_signature_step(
+                signature, i, i == 16 ? 1 : 3, flags );
+        }
+        wrapped = switchyard_clone_com_vtable_for_wrapping(
+            object, vtable, 17, FALSE, signature );
+        if (!wrapped) return;
+        for (i = 0; i < 17; ++i)
+        {
+            ULONG flags = SWITCHYARD_NATIVE_CALLBACK_SHARE_THUNK;
+            if (i == 5 || i == 6)
+                flags |= SWITCHYARD_NATIVE_CALLBACK_D3D11_CONTEXT_CLEAR_DEPTH_STENCIL_VIEW |
+                         SWITCHYARD_NATIVE_CALLBACK_OUTPUT_ARG( i == 5 ? 5 : 4 );
+            switchyard_wrap_native_callback_vtable_slot( &wrapped[i], i == 16 ? 1 : 3, flags );
+        }
+        switchyard_publish_com_vtable_clone_for_wrapping( object, wrapped );
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+    }
+    __ENDTRY
+}
