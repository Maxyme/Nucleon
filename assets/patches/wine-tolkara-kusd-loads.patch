  *
  * Handler for SIGSEGV.
  */
+#ifdef __APPLE__
+/* The relocated shared page remains authoritative. Only bounded scalar reads
+ * are emulated; instruction decoding and acquire semantics come from the pinned
+ * MacRunner Wine helper. No guest code, flags or memory protections are changed. */
+static volatile sig_atomic_t nucleon_shared_data_enabled;
+
+static void __attribute__((constructor)) nucleon_shared_data_init(void)
+{
+    const char *value = getenv( "NUCLEON_EMULATE_KUSD" );
+    nucleon_shared_data_enabled = value && value[0] == '1';
+}
+
+static BOOL nucleon_shared_data_read( siginfo_t *info, ucontext_t *context )
+{
+    uint64_t regs[31], pc = PC_sig(context), fault = (ULONG_PTR)info->si_addr;
+    uint32_t instruction;
+    mach_vm_size_t copied;
+    unsigned int i;
+    int saved_errno;
+    BOOL handled = FALSE;
+
+    if (!nucleon_shared_data_enabled || !user_shared_data ||
+        fault < MACRUNNER_FEX_KUSD_BASE ||
+        fault >= MACRUNNER_FEX_KUSD_BASE + MACRUNNER_FEX_KUSD_SIZE || (pc & 3)) return FALSE;
+    saved_errno = errno;
+    if (mach_vm_read_overwrite( mach_task_self(), pc, sizeof(instruction),
+                               (mach_vm_address_t)&instruction, &copied ) != KERN_SUCCESS ||
+        copied != sizeof(instruction)) goto done;
+    for (i = 0; i < 29; ++i) regs[i] = REGn_sig(i, context);
+    regs[29] = FP_sig(context);
+    regs[30] = LR_sig(context);
+    if (!macrunner_fex_kusd_emulate( instruction, fault, regs, SP_sig(context), &pc,
+                                   macrunner_fex_kusd_read_live, user_shared_data )) goto done;
+    for (i = 0; i < 29; ++i) REGn_sig(i, context) = regs[i];
+    FP_sig(context) = regs[29];
+    LR_sig(context) = regs[30];
+    PC_sig(context) = pc;
+    handled = TRUE;
+done:
+    errno = saved_errno;
+    return handled;
+}
+#endif
