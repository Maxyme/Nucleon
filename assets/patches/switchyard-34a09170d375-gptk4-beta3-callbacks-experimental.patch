             !is_native_callback_target_or_thunk( table[2] ) ||
-            !table[42] || !table[43])
+            !table[43] || !table[44])
             return;
 
         switchyard_allow_gptk_trampoline_data_section( table );
@@ -9180,7 +9180,7 @@
                                                SWITCHYARD_NATIVE_CALLBACK_WRAP_D3D11_OUTPUT_VTABLES ); /* D3D11CreateDeviceAndSwapChain */
         wrap_native_callback_entry_with_flags( &table[11], 0,
