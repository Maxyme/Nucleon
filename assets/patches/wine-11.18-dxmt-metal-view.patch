+struct dxmt_window_data
+{
+    HWND hwnd;
+    WineWindow * cocoa_window;
+    WineContentView * cocoa_view;
+    WineContentView * client_cocoa_view;
+};
+
+static _Thread_local struct dxmt_window_data dxmt_data;
+static _Thread_local struct macdrv_win_data *dxmt_locked_data;
+
+static struct dxmt_window_data *dxmt_get_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data = get_win_data(hwnd);
+    if (!data) return NULL;
+    dxmt_locked_data = data;
+    dxmt_data.hwnd = data->hwnd;
+    dxmt_data.cocoa_window = data->cocoa_window;
+    dxmt_data.cocoa_view = data->client_view;
+    if (!dxmt_data.cocoa_view && data->cocoa_window)
+        dxmt_data.cocoa_view = macdrv_window_get_content_view(data->cocoa_window);
+    dxmt_data.client_cocoa_view = dxmt_data.cocoa_view;
+    return &dxmt_data;
+}
+
+static void dxmt_release_win_data(struct dxmt_window_data *data)
+{
+    if (!data) return;
+    release_win_data(dxmt_locked_data);
+    dxmt_locked_data = NULL;
+}
